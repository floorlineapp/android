<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme; Compose owns everything after launch. -->
    <style name="Theme.Floor.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0E1424</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Floor</item>
    </style>

    <style name="Theme.Floor" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0E1424</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
